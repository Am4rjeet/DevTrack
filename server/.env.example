# ===========================================
# DEVTRACK Server Environment Variables
# ===========================================
# Copy this file to server/.env and fill in values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/devtrack?retryWrites=true&w=majority

# --- JWT Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Client ---
# Frontend URL for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# --- Cookies ---
# Dev: localhost | Prod cross-origin (Vercel+Render): leave empty or "none"
# Prod custom domain (app.example.com + api.example.com): .example.com
COOKIE_DOMAIN=localhost
# Must be true in production (HTTPS required for SameSite=None cookies)
COOKIE_SECURE=false

# --- CSRF ---
CSRF_SECRET=your-csrf-secret-min-32-chars

# --- GitHub Integration ---
# Server-side token for public API calls (5000 req/hr vs 60/hr unauthenticated)
# Create at: https://github.com/settings/tokens → Generate new token (classic)
# Scopes: read:user, public_repo (or repo for private data)
GITHUB_TOKEN=

# GitHub OAuth App (optional — enables one-click connect)
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:5173
# Callback URL: http://localhost:5000/api/v1/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/github/oauth/callback

# --- Email (Nodemailer / Gmail) ---
# Phase 3: used for verification and password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=DEVTRACK <your-email@gmail.com>

# --- Bot Protection (Cloudflare Turnstile) ---
# Create keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Secret stays on server only. Site key is public (used in client).
TURNSTILE_SECRET_KEY=

# --- Rate Limiting & Anti-Abuse ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
# Signup: 3 attempts per IP per hour (stops bot floods)
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=3
# Login: 15 failed attempts per 15 min per IP
LOGIN_RATE_LIMIT_MAX=15
# Daily signup cap per IP (tracked in MongoDB, auto-expires after 24h)
MAX_SIGNUPS_PER_IP_PER_DAY=5

# --- Encryption ---
# Used to encrypt GitHub OAuth tokens at rest (32-byte hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# --- Leaderboard Cron ---
# Recomputes rankings every 15 minutes by default
LEADERBOARD_CRON_ENABLED=true
LEADERBOARD_CRON_SCHEDULE=*/15 * * * *
